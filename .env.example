# Database Connection URL (SQLite for local dev, PostgreSQL for production Vercel)
# Local SQLite example: "file:./dev.db"
# Production PostgreSQL example: "postgresql://username:password@ep-cool-name-12345.us-east-1.aws.neon.tech/korals_db?sslmode=require"
DATABASE_URL="file:./dev.db"

# JWT Secret for Admin Session Encryption
JWT_SECRET="your-secure-production-jwt-secret-key-min-32-chars"

# Site Public URL
NEXT_PUBLIC_SITE_URL="https://korals-design.vercel.app"
